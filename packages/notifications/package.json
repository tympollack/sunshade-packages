{
  "name": "@digitalcanopy/notifications",
  "version": "0.1.2",
  "description": "Universal notification triage state machine, AI digest contracts, and collapsible digest card shared across SunShade apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react/index.ts --dts --format cjs,esm --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:boundaries": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "sunshade",
    "notifications",
    "triage",
    "digest",
    "react"
  ],
  "author": "SunShade Systems",
  "license": "MIT"
}
