{
  "name": "@digitalcanopy/ui",
  "version": "0.2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "sunshade-ui-audit": "./dist/audit/cli.js"
  },
  "files": [
    "src",
    "dist",
    "tailwind.preset.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./fonts": {
      "types": "./src/fonts/index.ts",
      "default": "./src/fonts/index.ts"
    },
    "./styles": {
      "types": "./src/styles/tailwind.config.ts",
      "default": "./src/styles/tailwind.config.ts"
    },
    "./tailwind": {
      "types": "./src/tailwind/index.ts",
      "default": "./src/tailwind/index.ts"
    },
    "./tailwind.preset": "./tailwind.preset.js",
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.mjs",
      "require": "./dist/audit/index.js",
      "default": "./dist/audit/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsup src/audit/cli.ts src/audit/index.ts --out-dir dist/audit --format cjs,esm --dts --external playwright --external @axe-core/playwright",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "vitest run"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@digitalcanopy/supabase": "*",
    "playwright": "^1.65.1"
  },
  "peerDependencies": {
    "nativewind": "*",
    "react": "*",
    "react-native": "*",
    "react-native-web": "*",
    "solito": "*"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "solito": {
      "optional": true
    },
    "@digitalcanopy/supabase": {
      "optional": true
    }
  }
}
