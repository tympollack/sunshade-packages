{
  "name": "@sunshade/assets",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./manifests": "./src/manifests/index.ts",
    "./resolvers": "./src/resolvers/cdn.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/manifests/index.ts src/resolvers/cdn.ts --dts --format cjs,esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
