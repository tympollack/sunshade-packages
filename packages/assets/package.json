{
  "name": "@digitalcanopy/assets",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./manifests": {
      "types": "./dist/manifests/index.d.ts",
      "import": "./dist/manifests/index.mjs",
      "require": "./dist/manifests/index.js"
    },
    "./resolvers": {
      "types": "./dist/resolvers/cdn.d.ts",
      "import": "./dist/resolvers/cdn.mjs",
      "require": "./dist/resolvers/cdn.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/manifests/index.ts src/resolvers/cdn.ts --dts --format cjs,esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:boundaries": "vitest run"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
