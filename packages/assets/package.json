{
  "name": "@sunshade/assets",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifests": {
      "types": "./src/manifests/index.ts",
      "default": "./src/manifests/index.ts"
    },
    "./resolvers": {
      "types": "./src/resolvers/index.ts",
      "default": "./src/resolvers/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
